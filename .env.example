# 실제 값은 절대 이 파일에 커밋하지 마세요. 로컬에서는 이 파일을 .env로 복사한 뒤 값을 채우세요.
# .env는 .gitignore에 의해 git 추적에서 제외됩니다.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- 메일 발송(알림 채널, lib/notifications) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
EMAIL_USER=
RECEIVER_EMAIL=

# --- PortOne(결제) ---
# NEXT_PUBLIC_ 접두사가 붙은 값은 브라우저 SDK가 사용하므로 클라이언트에 노출되어도 되는(publishable) 값입니다.
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
PORTONE_SECRET=
PORTONE_WEBHOOK_SECRET=

# --- 배치(Cron) ---
# FR-12: 홀드 자동 만료 배치 인증용. Vercel Project Settings > Environment Variables에도 동일 값을 등록해야 한다.
CRON_SECRET=
